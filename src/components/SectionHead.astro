---
interface Props {
  index: string;
  title: string;
}
const { index, title } = Astro.props;
---

<div class="mb-10 border-b border-line pb-5">
  <span class="mb-1.5 block text-[0.78rem] font-bold uppercase tracking-[0.12em] text-brand">{index}</span>
  <h2 class="text-[clamp(1.7rem,3vw,2.15rem)] font-extrabold tracking-tight text-ink">{title}</h2>
</div>
