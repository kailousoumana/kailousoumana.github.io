---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page introuvable — ${site.name}`} description="Cette page n'existe pas. Retour au portfolio.">
  <main id="main" class="wrap flex min-h-screen flex-col items-start justify-center gap-4 py-20">
    <p class="text-[0.78rem] font-bold uppercase tracking-[0.12em] text-brand">Erreur 404</p>
    <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] font-extrabold tracking-tight text-ink">Page introuvable</h1>
    <p class="max-w-[520px] text-muted">Le lien demandé n'existe pas ou a été déplacé.</p>
    <a href="/" class="btn btn-solid mt-2">Retour au portfolio</a>
  </main>
</Base>
