---
import { site, nav } from '../data/site';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-[1000] border-b border-line bg-bg/90 backdrop-blur-md">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3.5">
    <a href="#haut" class="inline-flex items-center gap-3 text-ink">
      <span class="inline-flex h-[38px] w-[38px] items-center justify-center rounded-[10px] bg-brand text-[0.92rem] font-extrabold tracking-wide text-on-brand" aria-hidden="true">{site.initials}</span>
      <span class="flex flex-col leading-tight">
        <strong class="text-[0.98rem]">{site.name}</strong>
        <small class="text-[0.78rem] text-muted">{site.role}</small>
      </span>
    </a>

    <div class="flex items-center gap-5">
      <nav class="flex flex-wrap gap-x-6 gap-y-1.5" aria-label="Navigation principale">
        {nav.map((n) => (
          <a href={n.href} class="relative py-1 text-[0.93rem] font-semibold text-muted transition hover:text-brand after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-brand after:transition-all hover:after:w-full">
            {n.label}
          </a>
        ))}
      </nav>
      <button
        id="theme-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line text-muted transition hover:text-brand hover:border-line-hover"
        aria-label="Basculer le thème clair / sombre"
      >
        <span class="hidden dark:block"><Icon name="sun" class="h-[18px] w-[18px]" /></span>
        <span class="block dark:hidden"><Icon name="moon" class="h-[18px] w-[18px]" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (e) {}
  });
</script>
