---
import { site } from '../data/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-[#080b12] py-10 text-white/65">
  <div class="wrap flex flex-wrap items-center justify-between gap-5">
    <div class="flex items-center gap-3">
      <span class="inline-flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-[10px] bg-gradient-to-br from-[#1b4677] to-[#0f2847] text-[0.92rem] font-extrabold tracking-wide text-white shadow-[0_3px_10px_rgba(0,0,0,0.35)] ring-1 ring-inset ring-white/20" aria-hidden="true">{site.initials}</span>
      <div>
        <strong class="block text-[0.98rem] text-white">{site.name}</strong>
        <p class="text-[0.84rem]">{site.role} · {site.location}</p>
      </div>
    </div>
    <div class="flex gap-[22px] text-[0.9rem]">
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white hover:underline">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white hover:underline">GitHub</a>
      <a href={site.cv} target="_blank" rel="noopener noreferrer" class="text-white/75 hover:text-white hover:underline">CV (PDF)</a>
    </div>
    <p class="text-[0.84rem] text-white/45">© {year} {site.name}</p>
  </div>

  <a
    href="#haut"
    id="to-top"
    class="pointer-events-none fixed bottom-6 right-6 z-[900] flex h-11 w-11 items-center justify-center rounded-[10px] bg-brand text-on-brand opacity-0 shadow-[0_6px_20px_rgba(20,54,93,0.32)] transition hover:-translate-y-0.5 hover:opacity-90"
    aria-label="Retour en haut"
    title="Retour en haut"
  >
    <Icon name="up" class="h-5 w-5" />
  </a>
</footer>

<script>
  // Le bouton n'apparaît qu'après un défilement significatif
  const toTop = document.getElementById('to-top');
  const update = () => {
    const show = window.scrollY > 600;
    toTop?.classList.toggle('opacity-0', !show);
    toTop?.classList.toggle('pointer-events-none', !show);
    if (toTop) toTop.tabIndex = show ? 0 : -1;
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
