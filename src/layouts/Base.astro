---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
  noindex = false,
} = Astro.props;

const canonical = site.url;
const ogImage = new URL(site.ogImage, site.url).href;
const ogAlt = `${site.name} — ${site.role}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  image: new URL('/profil.webp', site.url).href,
  knowsAbout: ['Spring Boot', 'NestJS', 'FastAPI', 'Angular', 'Microservices', 'GitLab CI/CD', 'OAuth2', 'KYC'],
  url: site.url,
  address: { '@type': 'PostalAddress', addressLocality: 'Niamey', addressCountry: 'NE' },
  worksFor: { '@type': 'Organization', name: site.employer },
  alumniOf: { '@type': 'EducationalOrganization', name: 'ESCEP-Niger' },
  sameAs: [site.linkedin, site.github],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="theme-color" content="#14365d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Thème appliqué avant le rendu pour éviter le flash -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>
  </head>
  <body id="haut" class="font-sans">
    <a
      href="#main"
      class="absolute left-4 -top-[999px] z-[2000] rounded-lg bg-brand px-4 py-2.5 font-semibold text-on-brand focus:top-3"
    >
      Aller au contenu
    </a>
    <slot />
  </body>
</html>
