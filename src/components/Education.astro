---
import { degrees, languages } from '../data/site';
import SectionHead from './SectionHead.astro';

const groups = [
  { title: 'Diplômes académiques', items: degrees },
  { title: 'Langues', items: languages },
];
---

<section id="formation" class="section">
  <div class="wrap">
    <SectionHead
      index="04 · Cursus"
      title="Formation & Langues"
    />

    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr]">
      {groups.map((g) => (
        <div>
          <h3 class="mb-4 text-[1.05rem] font-bold text-muted">{g.title}</h3>
          {g.items.map((i) => (
            <article class="mb-3.5 rounded-2xl border border-line bg-soft px-6 py-[22px]">
              <span class="mb-1.5 inline-block text-[0.76rem] font-bold uppercase tracking-[0.06em] text-brand">{i.badge}</span>
              <h4 class="mb-1 text-[1.06rem] font-bold text-ink">{i.title}</h4>
              <p class="text-[0.9rem] text-muted">{i.text}</p>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
